---
import '../styles/global.css';
import BarraSistema from '../components/BarraSistema.astro';
import Dock from '../components/Dock.astro';
import PieDePagina from '../components/PieDePagina.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  titulo: string;
  descripcion: string;
  imagen?: string;
}

const { titulo, descripcion, imagen = '/marca/png/nexoria-horizontal-color-1024.png' } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
const imagenAbs = new URL(imagen, Astro.site);
const tituloCompleto = titulo === 'Nexoria' ? titulo : `${titulo} · Nexoria`;
---

<!doctype html>
<html lang="es-CL">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{tituloCompleto}</title>
  <meta name="description" content={descripcion} />
  <link rel="canonical" href={url} />
  <meta name="theme-color" content="#050918" />

  <link rel="icon" href="/favicon/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon/favicon.ico" sizes="any" />
  <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Nexoria" />
  <meta property="og:locale" content="es_CL" />
  <meta property="og:title" content={tituloCompleto} />
  <meta property="og:description" content={descripcion} />
  <meta property="og:url" content={url} />
  <meta property="og:image" content={imagenAbs} />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="preload" href="/fuentes/Montserrat[wght].ttf" as="font" type="font/ttf" crossorigin />

  <ClientRouter />

  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Nexoria',
    url: 'https://nexoriachile.com/',
    logo: 'https://nexoriachile.com/marca/png/nexoria-horizontal-color-1024.png',
    email: 'contacto@nexoriachile.com',
    description: 'Monitoreo industrial en tiempo real y mantenimiento predictivo para líneas de producción.',
    address: { '@type': 'PostalAddress', addressLocality: 'Concepción', addressRegion: 'Biobío', addressCountry: 'CL' },
  })} />
</head>

<body>
  <a href="#principal" class="saltar">Saltar al contenido</a>

  <BarraSistema transition:persist />
  <Dock transition:animate="none" />

  <!-- Indicador de avance, a la derecha, como una columna de nivel -->
  <div class="avance" aria-hidden="true"><span id="avance-barra"></span></div>
  <div class="barrido" id="barrido" aria-hidden="true"></div>

  <div class="consola">
    <main id="principal">
      <slot />
    </main>
    <PieDePagina />
  </div>

  <style is:global>
    :root {
      --bs-alto: 46px;
      --dock-alto: 92px;
    }

    .consola {
      padding-top: var(--bs-alto);
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
    }
    .consola > main { flex: 1; }

    /* Aire al final para que el dock no tape el pie de página */
    .consola > :global(footer) { padding-bottom: var(--dock-alto); }

    @media (max-width: 720px) { :root { --dock-alto: 84px; } }

    .saltar {
      position: absolute; left: 12px; top: -60px; z-index: 100;
      background: var(--nx-cian); color: #04121c; padding: 10px 18px;
      border-radius: 0 0 10px 10px; font-weight: 700; transition: top .2s ease;
    }
    .saltar:focus { top: var(--bs-alto); }

    /* El riel, la barra y el avance se capturan por separado: al tener nombre
       propio quedan fuera de la animación de la raíz y no se mueven al navegar. */
    .bs     { view-transition-name: nx-barra; }
    .dock   { view-transition-name: nx-dock; }
    .avance { view-transition-name: nx-avance; }
    .barrido { view-transition-name: nx-barrido; }

    /* ---- Transición entre páginas ----
       El contenido sale hacia arriba y el nuevo entra desde abajo, con un
       barrido de luz al borde del riel. El riel y la barra no se mueven:
       el sitio se comporta como una aplicación, no como páginas sueltas. */
    @keyframes nx-salir {
      to { opacity: 0; transform: translateY(-14px); filter: blur(3px); }
    }
    @keyframes nx-entrar {
      from { opacity: 0; transform: translateY(22px); filter: blur(4px); }
    }

    ::view-transition-old(root) {
      animation: nx-salir .3s cubic-bezier(.4, 0, 1, 1) forwards;
    }
    ::view-transition-new(root) {
      animation: nx-entrar .48s cubic-bezier(.16, .84, .32, 1) .06s backwards;
    }

    /* Barrido de carga sobre el riel */
    .barrido {
      position: fixed; z-index: 71; inset-inline: 0; top: var(--bs-alto);
      height: 2px; pointer-events: none; overflow: hidden; opacity: 0;
    }
    .barrido::after {
      content: ''; position: absolute; inset-block: 0; width: 34%;
      background: linear-gradient(90deg, transparent, var(--nx-cian), transparent);
      box-shadow: 0 0 14px rgba(70, 192, 216, .9);
      transform: translateX(-120%);
    }
    .barrido.activo { opacity: 1; }
    .barrido.activo::after { animation: nx-barrer .7s cubic-bezier(.4, 0, .25, 1); }
    @keyframes nx-barrer {
      from { transform: translateX(-120%); }
      to { transform: translateX(400%); }
    }

    @media (prefers-reduced-motion: reduce) {
      ::view-transition-old(root), ::view-transition-new(root) { animation: none; }
      .barrido { display: none; }
    }

    /* columna de avance */
    .avance {
      position: fixed; z-index: 64; right: 0; top: var(--barra-alto); bottom: 0; width: 3px;
      background: rgba(110, 170, 235, .1);
    }
    .avance span {
      display: block; width: 100%; height: 0;
      background: linear-gradient(180deg, var(--nx-cian), var(--nx-azul));
      box-shadow: 0 0 12px rgba(70, 192, 216, .8);
    }
    @media (max-width: 900px) { .avance { display: none; } }
  </style>

  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import Lenis from 'lenis';

    gsap.registerPlugin(ScrollTrigger);

    const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let lenis: Lenis | null = null;

    // El scroll suave se monta una sola vez: sobrevive a los cambios de página.
    if (!reducido && !lenis) {
      lenis = new Lenis({ duration: 1.05, smoothWheel: true });
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add((t) => lenis!.raf(t * 1000));
      gsap.ticker.lagSmoothing(0);
    }

    // Solo se descartan los disparadores creados AQUÍ. Matar todos borraba
    // también los de los componentes, porque el orden de los listeners de
    // astro:page-load no está garantizado.
    let mios: ScrollTrigger[] = [];

    function montarAnimaciones() {
      mios.forEach((t) => t.kill());
      mios = [];
      lenis?.scrollTo(0, { immediate: true });

      const barra = document.getElementById('avance-barra');
      if (barra) {
        gsap.set(barra, { height: 0 });
        const tw = gsap.to(barra, {
          height: '100%',
          ease: 'none',
          scrollTrigger: { trigger: document.body, start: 'top top', end: 'bottom bottom', scrub: 0.3 },
        });
        mios.push(tw.scrollTrigger!);
      }

      // Entradas: cada .revelar sube al asomarse; los hermanos se escalonan.
      const grupos = new Map<Element, Element[]>();
      document.querySelectorAll<HTMLElement>('.revelar').forEach((el) => {
        const padre = el.parentElement!;
        if (!grupos.has(padre)) grupos.set(padre, []);
        grupos.get(padre)!.push(el);
      });

      for (const [, hijos] of grupos) {
        const tw = gsap.from(hijos, {
          y: reducido ? 0 : 30,
          opacity: 0,
          duration: reducido ? 0 : 0.8,
          ease: 'power3.out',
          stagger: reducido ? 0 : 0.08,
          scrollTrigger: { trigger: hijos[0], start: 'top 88%', once: true },
        });
        if (tw.scrollTrigger) mios.push(tw.scrollTrigger);
      }

      if (!reducido) {
        document.querySelectorAll<HTMLElement>('[data-paralaje]').forEach((el) => {
          const tw = gsap.to(el, {
            yPercent: Number(el.dataset.paralaje),
            ease: 'none',
            scrollTrigger: { trigger: el, start: 'top bottom', end: 'bottom top', scrub: 0.6 },
          });
          if (tw.scrollTrigger) mios.push(tw.scrollTrigger);
        });
      }

      // Entrada de la portada: encadenada, no todo de golpe
      const hero = document.querySelector('.hp');
      if (hero && !reducido) {
        const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
        tl.from('.hp__insignia', { y: 16, opacity: 0, duration: .55 })
          .from('.hp h1', { y: 26, opacity: 0, duration: .75 }, '-=.32')
          .from('.hp__bajada', { y: 20, opacity: 0, duration: .65 }, '-=.48')
          .from('.hp__acciones > *', { y: 16, opacity: 0, duration: .5, stagger: .09 }, '-=.42')
          .from('.hp__sellos li', { y: 12, opacity: 0, duration: .45, stagger: .07 }, '-=.34')
          .from('.hp__producto', { x: 44, opacity: 0, duration: .95 }, '-=1.05')
          .from('.hp__etiqueta', { y: -10, opacity: 0, duration: .4 }, '-=.3');
      }

      ScrollTrigger.refresh();
    }

    // Barrido sobre el riel mientras se cambia de página
    const barrido = document.getElementById('barrido');
    document.addEventListener('astro:before-preparation', () => barrido?.classList.add('activo'));
    document.addEventListener('astro:after-swap', () => {
      setTimeout(() => barrido?.classList.remove('activo'), 480);
    });

    document.addEventListener('astro:page-load', montarAnimaciones);
    addEventListener('load', () => ScrollTrigger.refresh());
  </script>
</body>
</html>
