---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Cabecera from '../components/Cabecera.astro';
import VistaProducto from '../components/VistaProducto.astro';

const productos = (await getCollection('productos')).sort((a, b) => a.data.orden - b.data.orden);
const amprod = productos.find((p) => p.id === 'amprod') ?? productos[0];
// `render` solo se puede llamar en el frontmatter, así que guardamos el
// resultado y usamos `renderizado.Content` dentro del bloque condicional.
const renderizado = amprod ? await render(amprod) : null;
const otros = productos.filter((p) => p.id !== amprod?.id);

const etiquetaEstado = {
  disponible: 'Disponible',
  beta: 'En beta',
  desarrollo: 'En desarrollo',
} as const;
---

<Base
  titulo={amprod ? amprod.data.nombre : 'AMPROD'}
  descripcion={amprod?.data.resumen ?? 'La plataforma de Nexoria para el monitoreo de variadores de frecuencia en tiempo real.'}
>
  <Cabecera
    seccion="Plataforma"
    titulo={amprod?.data.nombre ?? 'AMPROD'}
    destacado={amprod?.data.lema}
    bajada={amprod?.data.resumen ?? ''}
    ruta={[{ texto: 'AMPROD' }]}
  >
    {amprod?.data.url && (
      <a href={amprod.data.url} class="btn btn--primario" rel="noopener">
        Ingresar a la plataforma
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
      </a>
    )}
    <a href="/contacto/" class="btn btn--fantasma">Solicitar una demo</a>
  </Cabecera>

  {amprod && (
    <>
      <section class="seccion seccion--vista">
        <div class="contenedor">
          <div class="vista-envoltura revelar">
            <VistaProducto />
          </div>
        </div>
      </section>

      <section class="seccion">
        <div class="contenedor">
          <div class="intro revelar">
            <img src="/marca/svg/nexoria-amprod-color.svg" alt={`Nexoria ${amprod.data.nombre}`} class="intro__logo" width="260" height="70" />
            <div class="intro__texto">
              {renderizado && <renderizado.Content />}
            </div>
          </div>
        </div>
      </section>

      {amprod.data.caracteristicas.length > 0 && (
        <section class="seccion seccion--gris">
          <div class="contenedor">
            <div class="cabecera cabecera--centro revelar">
              <span class="sobretitulo">Capacidades</span>
              <h2>Lo que puedes hacer con <span class="grad">{amprod.data.nombre}</span></h2>
            </div>
            <div class="rejilla rejilla--3">
              {amprod.data.caracteristicas.map((c) => (
                <article class="tarjeta revelar">
                  <h3>{c.titulo}</h3>
                  <p>{c.detalle}</p>
                </article>
              ))}
            </div>
          </div>
        </section>
      )}
    </>
  )}

  {otros.length > 0 && (
    <section class="seccion">
      <div class="contenedor">
        <div class="cabecera revelar">
          <span class="sobretitulo">Más productos</span>
          <h2>Otras soluciones Nexoria</h2>
        </div>
        <div class="rejilla rejilla--2">
          {otros.map((p) => (
            <article class="tarjeta revelar">
              <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
                <h3>{p.data.nombre}</h3>
                <span class:list={['pastilla', `pastilla--${p.data.estado}`]}>{etiquetaEstado[p.data.estado]}</span>
              </div>
              <p>{p.data.resumen}</p>
              {p.data.url && (
                <a href={p.data.url} class="btn btn--secundario" rel="noopener" style="margin-top:20px">Ver más</a>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="seccion seccion--noche">
    <div class="contenedor cabecera cabecera--centro revelar" style="margin-bottom:0">
      <h2>¿Quieres verlo con tus propios equipos?</h2>
      <p class="bajada">
        Agendamos una demostración y te mostramos cómo se vería tu planta dentro de la plataforma.
      </p>
      <div style="display:flex;gap:13px;justify-content:center;flex-wrap:wrap;margin-top:30px">
        <a href="/contacto/" class="btn btn--primario">Agendar demo</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .seccion--vista { background: var(--nx-noche); padding-block: clamp(44px, 6vw, 72px); }
  .vista-envoltura { max-width: 980px; margin: 0 auto; }

  .intro { display: grid; gap: 40px; grid-template-columns: minmax(220px, 300px) minmax(0, 1fr); align-items: start; }
  .intro__logo { width: 100%; max-width: 280px; height: auto; }
  .intro__texto { font-size: 17.5px; color: var(--texto-2); }
  .intro__texto :global(p) { margin-bottom: 18px; max-width: 62ch; }

  .pastilla {
    font-size: 11.5px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
    padding: 5px 11px; border-radius: 999px;
  }
  .pastilla--disponible { background: rgba(70, 192, 216, .16); color: #1a7f96; }
  .pastilla--beta { background: rgba(49, 165, 221, .15); color: #1d6f99; }
  .pastilla--desarrollo { background: #eef1f6; color: var(--texto-3); }

  @media (max-width: 820px) { .intro { grid-template-columns: 1fr; gap: 28px; } }
</style>
