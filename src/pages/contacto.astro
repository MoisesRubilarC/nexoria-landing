---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Cabecera from '../components/Cabecera.astro';

const servicios = (await getCollection('servicios')).sort((a, b) => a.data.orden - b.data.orden);

// Endpoint del Worker de Cloudflare que envía el correo con Resend.
// Se define en .env como PUBLIC_ENDPOINT_COTIZACION.
const endpoint = import.meta.env.PUBLIC_ENDPOINT_COTIZACION ?? '';
---

<Base
  titulo="Contacto y cotización"
  descripcion="Cuéntanos qué equipos quieres monitorear y te preparamos una propuesta a tu medida, sin costo y sin compromiso."
>
  <Cabecera
    seccion="Hablemos"
    titulo="Cuéntanos de tu planta"
    bajada="Completa el formulario y te respondemos dentro de un día hábil con una propuesta ajustada a tu operación. Sin costo y sin compromiso."
    ruta={[{ texto: 'Contacto' }]}
  />

  <section class="seccion">
    <div class="contenedor contacto">
      <form class="formulario revelar" id="form-cotizacion" data-endpoint={endpoint} novalidate>
        <div class="campos">
          <label class="campo">
            <span>Nombre y apellido <i>*</i></span>
            <input type="text" name="nombre" required autocomplete="name" maxlength="120" />
          </label>

          <label class="campo">
            <span>Empresa <i>*</i></span>
            <input type="text" name="empresa" required autocomplete="organization" maxlength="120" />
          </label>

          <label class="campo">
            <span>Correo <i>*</i></span>
            <input type="email" name="correo" required autocomplete="email" maxlength="160" />
          </label>

          <label class="campo">
            <span>Teléfono</span>
            <input type="tel" name="telefono" autocomplete="tel" maxlength="40" placeholder="+56 9 ..." />
          </label>

          <label class="campo campo--ancho">
            <span>¿Qué te interesa?</span>
            <select name="servicio">
              <option value="">Prefiero explicarlo abajo</option>
              {servicios.map((s) => <option value={s.data.titulo}>{s.data.titulo}</option>)}
              <option value="AMPROD (demo de la plataforma)">AMPROD — demo de la plataforma</option>
            </select>
          </label>

          <label class="campo campo--ancho">
            <span>Cuéntanos tu caso <i>*</i></span>
            <textarea
              name="mensaje"
              rows="6"
              required
              maxlength="4000"
              placeholder="Qué equipos tienes, cuántos son, qué te gustaría monitorear o qué problema estás tratando de resolver."
            ></textarea>
          </label>
        </div>

        <!-- Trampa anti-spam: invisible para personas, tentadora para bots. -->
        <div class="trampa" aria-hidden="true">
          <label>No llenar este campo<input type="text" name="sitio_web" tabindex="-1" autocomplete="off" /></label>
        </div>

        <div class="envio">
          <button type="submit" class="btn btn--primario" id="btn-enviar">
            Enviar solicitud
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
          </button>
          <p class="nota">Usamos tus datos solo para responderte esta consulta.</p>
        </div>

        <p class="aviso" id="aviso" role="status" aria-live="polite" hidden></p>
      </form>

      <aside class="lado revelar">
        <div class="tarjeta">
          <h3>Contacto directo</h3>
          <p>Si prefieres escribirnos tú:</p>
          <a href="mailto:contacto@nexoriachile.com" class="lado__enlace">contacto@nexoriachile.com</a>
          <p style="margin-top:14px">Ventas:</p>
          <a href="tel:+56987412857" class="lado__enlace">+56 9 8741 2857</a>
          <a href="https://wa.me/56987412857?text=Hola%2C%20quiero%20cotizar%20monitoreo%20con%20Nexoria." class="btn btn--wsp" rel="noopener" target="_blank" style="margin-top:12px">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg> Comuniquémonos
          </a>
          <hr />
          <h3>Dónde estamos</h3>
          <p>Concepción, Región del Biobío, Chile.<br />Trabajamos con plantas de todo el país.</p>
          <hr />
          <h3>¿Ya eres cliente?</h3>
          <p>Entra directo a la plataforma.</p>
          <a href="https://amprod.nexoriachile.com/" class="btn btn--secundario" rel="noopener" style="margin-top:12px">
            Ingresar a AMPROD
          </a>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .contacto { display: grid; gap: 40px; grid-template-columns: minmax(0, 1.7fr) minmax(290px, 1fr); align-items: start; }

  .campos { display: grid; gap: 20px; grid-template-columns: 1fr 1fr; }
  .campo { display: flex; flex-direction: column; gap: 8px; }
  .campo--ancho { grid-column: 1 / -1; }
  .campo > span { font-size: 14px; font-weight: 600; color: var(--nx-indigo); }
  .campo i { color: #c0392b; font-style: normal; }

  input, select, textarea {
    font-family: inherit; font-size: 15.5px; color: var(--texto);
    padding: 12px 14px; border: 1px solid var(--borde); border-radius: var(--radio-sm);
    background: #fff; width: 100%;
    transition: border-color .2s ease, box-shadow .2s ease;
  }
  textarea { resize: vertical; min-height: 130px; }
  input:focus, select:focus, textarea:focus {
    outline: none; border-color: var(--nx-cielo);
    box-shadow: 0 0 0 4px rgba(49, 165, 221, .14);
  }
  input[aria-invalid='true'], textarea[aria-invalid='true'] { border-color: #c0392b; }

  .trampa { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .envio { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; margin-top: 26px; }
  .nota { font-size: 13.5px; color: var(--texto-3); }

  .aviso { margin-top: 20px; padding: 14px 18px; border-radius: var(--radio-sm); font-size: 15px; }
  .aviso.ok { background: rgba(70, 192, 216, .12); color: #146b80; border: 1px solid rgba(70, 192, 216, .4); }
  .aviso.error { background: #fdf0ee; color: #a5342a; border: 1px solid #f0c8c2; }

  .lado .tarjeta { position: sticky; top: 96px; }
  .lado h3 { font-size: 17px; }
  .lado p { font-size: 15px; }
  .lado__enlace { display: inline-block; margin-top: 8px; font-weight: 600; word-break: break-all; }
  .lado hr { border: none; border-top: 1px solid var(--borde); margin: 22px 0; }

  @media (max-width: 880px) {
    .contacto { grid-template-columns: 1fr; }
    .lado .tarjeta { position: static; }
  }
  @media (max-width: 560px) { .campos { grid-template-columns: 1fr; } }
</style>

<script>
function montarFormulario() {

    // El script viaja en todas las páginas; sin formulario no hay nada que hacer.
    const form = document.getElementById('form-cotizacion') as HTMLFormElement | null;
    const botonEl = document.getElementById('btn-enviar') as HTMLButtonElement | null;
    const avisoEl = document.getElementById('aviso') as HTMLParagraphElement | null;
    if (!form || !botonEl || !avisoEl) return;
    const boton = botonEl;
    const aviso = avisoEl;
    const endpoint = form.dataset.endpoint ?? '';

    function mostrar(texto: string, tipo: 'ok' | 'error', conWhatsapp = false) {
      aviso.textContent = texto;
      if (conWhatsapp) {
        const a = document.createElement('a');
        a.href = 'https://wa.me/56987412857?text=Hola%2C%20quiero%20cotizar%20monitoreo%20con%20Nexoria.';
        a.target = '_blank';
        a.rel = 'noopener';
        a.textContent = 'Comuniquémonos por WhatsApp';
        a.style.cssText = 'display:inline-block;margin-top:8px;font-weight:700;text-decoration:underline';
        aviso.append(document.createElement('br'), a);
      }
      aviso.className = `aviso ${tipo}`;
      aviso.hidden = false;
    }

    const msjFallo = 'No pudimos enviar el formulario. Escríbenos a contacto@nexoriachile.com o llama a ventas: +56 9 8741 2857.';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Validación propia para poder marcar los campos y dar un mensaje en español.
      let primeroInvalido: HTMLElement | null = null;
      for (const el of form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]')) {
        const malo = !el.checkValidity();
        el.setAttribute('aria-invalid', String(malo));
        if (malo && !primeroInvalido) primeroInvalido = el;
      }
      if (primeroInvalido) {
        mostrar('Revisa los campos marcados: faltan datos o el correo no es válido.', 'error');
        primeroInvalido.focus();
        return;
      }

      const datos = new FormData(form);
      if (datos.get('sitio_web')) return; // bot

      if (!endpoint) { mostrar(msjFallo, 'error', true); return; }

      boton.disabled = true;
      const textoOriginal = boton.innerHTML;
      boton.textContent = 'Enviando…';
      aviso.hidden = true;

      try {
        const r = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(datos)),
        });
        if (!r.ok) throw new Error(String(r.status));
        form.reset();
        mostrar('¡Listo! Recibimos tu solicitud y te respondemos dentro de un día hábil.', 'ok');
      } catch {
        mostrar(msjFallo, 'error', true);
      } finally {
        boton.disabled = false;
        boton.innerHTML = textoOriginal;
      }
    });

}

document.addEventListener('astro:page-load', montarFormulario);
</script>
