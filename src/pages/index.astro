---
import Base from '../layouts/Base.astro';
import HeroProducto from '../components/HeroProducto.astro';
import Contraste from '../components/Contraste.astro';
import ServiciosCarrusel from '../components/ServiciosCarrusel.astro';
import PanelMonitoreo from '../components/PanelMonitoreo.astro';
import Cifras from '../components/Cifras.astro';
import Objeciones from '../components/Objeciones.astro';
import Clientes from '../components/Clientes.astro';

const pasos = [
  { n: '01', t: 'Visitamos tu planta', d: 'Vamos a terreno, revisamos qué equipos tienes y cuáles son críticos para tu producción. Sin costo.' },
  { n: '02', t: 'Conectamos', d: 'Instalamos la captura de datos sobre los equipos que ya están, sin detener la línea.' },
  { n: '03', t: 'Dejamos operando', d: 'Tableros y alertas funcionando, y tu equipo de mantención capacitado para usarlos.' },
  { n: '04', t: 'Seguimos encima', d: 'Afinamos umbrales y sumamos equipos a medida que se acumula histórico.' },
];
---

<Base
  titulo="Nexoria"
  descripcion="Monitoreo industrial en tiempo real para líneas de producción. Conectamos tus variadores y sensores, y avisamos cuando un equipo empieza a fallar: antes de la parada, no después."
>
  <HeroProducto />

  <!-- 1. El problema, antes que cualquier característica -->
  <Contraste />

  <!-- 2. Qué hacemos, en horizontal -->
  <ServiciosCarrusel />

  <!-- 3. La prueba: el producto funcionando -->
  <PanelMonitoreo />

  <Cifras />

  <!-- 4. Cómo se parte -->
  <section class="seccion proceso">
    <div class="contenedor">
      <div class="cabecera revelar">
        <span class="sobretitulo">Cómo partimos</span>
        <h2>De la primera visita<br /><span class="grad">a la planta monitoreada</span></h2>
      </div>

      <ol class="pasos">
        {pasos.map((p) => (
          <li class="paso revelar">
            <span class="paso__n">{p.n}</span>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 5. Las dudas que frenan -->
  <Objeciones />

  <Clientes />

  <!-- 6. Cierre -->
  <section class="cierre">
    <div class="contenedor cierre__caja revelar">
      <span class="sobretitulo">Siguiente paso</span>
      <h2>Partamos por un equipo</h2>
      <p>
        No hace falta comprometer la planta entera. Elegimos juntos el equipo que más
        te preocupa, lo dejamos monitoreado y decides con datos sobre la mesa.
      </p>
      <div class="cierre__acciones">
        <a href="/contacto/" class="btn btn--primario">
          Solicitar cotización
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
        </a>
        <a href="https://wa.me/56987412857?text=Hola%2C%20quiero%20cotizar%20monitoreo%20con%20Nexoria." class="btn btn--wsp" rel="noopener" target="_blank"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg> Comuniquémonos</a>
      </div>
      <span class="cierre__pie">Visita y propuesta sin costo · Región del Biobío y todo Chile</span>
    </div>
  </section>
</Base>

<style>
  .pasos { display: grid; gap: 22px; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); list-style: none; }
  .paso { position: relative; padding: 26px 20px 26px 0; border-top: 2px solid var(--fondo-3); }
  .paso::after {
    content: ''; position: absolute; left: 0; top: -2px; width: 0; height: 2px;
    background: var(--nx-degradado);
    transition: width .6s cubic-bezier(.2, .7, .2, 1);
  }
  .paso:hover::after { width: 100%; }
  .paso__n { display: block; font-size: 13px; font-weight: 700; letter-spacing: .12em; color: var(--nx-cielo); margin-bottom: 12px; }
  .paso h3 { font-size: 18.5px; }
  .paso p { margin-top: 10px; color: var(--texto-2); font-size: 15px; }

  .cierre { background: var(--nx-noche); padding: clamp(56px, 8vw, 96px) 0 clamp(64px, 9vw, 104px); }
  .cierre__caja {
    position: relative;
    max-width: 760px; text-align: center;
    padding: clamp(36px, 5vw, 56px) clamp(24px, 4vw, 48px);
    border: 1px solid rgba(110, 170, 235, .22);
    border-radius: 20px;
    background:
      radial-gradient(120% 140% at 50% 0%, rgba(45, 102, 171, .34), transparent 62%),
      rgba(255, 255, 255, .03);
    overflow: hidden;
  }
  .cierre__caja::before {
    content: ''; position: absolute; inset-inline: 0; top: 0; height: 1px;
    background: linear-gradient(90deg, transparent, var(--nx-cian), transparent);
  }
  .cierre__caja :global(h2) { color: #fff; }
  .cierre__caja p { margin: 16px auto 0; max-width: 52ch; color: #a9b6d4; font-size: 17px; }
  .cierre__acciones { display: flex; flex-wrap: wrap; gap: 13px; justify-content: center; margin-top: 32px; }
  .cierre__pie {
    display: block; margin-top: 24px;
    font-size: 12.5px; letter-spacing: .07em; text-transform: uppercase; color: #5d6a8c; font-weight: 600;
  }
</style>
