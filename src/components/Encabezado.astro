---
const { pathname } = Astro.url;
const esActivo = (ruta: string) =>
  ruta === '/' ? pathname === '/' : pathname.startsWith(ruta);

const enlaces = [
  { href: '/servicios/', texto: 'Servicios' },
  { href: '/amprod/', texto: 'AMPROD' },
  { href: '/nosotros/', texto: 'Nosotros' },
  { href: '/contacto/', texto: 'Contacto' },
];
---

<header class="cab" id="cab">
  <div class="contenedor cab__fila">
    <a href="/" class="cab__logo" aria-label="Nexoria — inicio">
      <img src="/marca/svg/nexoria-horizontal-color.svg" alt="Nexoria" width="150" height="34" />
    </a>

    <nav class="cab__nav" aria-label="Principal">
      {enlaces.map((e) => (
        <a href={e.href} class:list={['cab__enlace', { 'es-activo': esActivo(e.href) }]}>
          {e.texto}
        </a>
      ))}
    </nav>

    <div class="cab__acciones">
      <a href="https://amprod.nexoriachile.com/" class="cab__acceso" rel="noopener">Ingresar</a>
      <a href="/contacto/" class="btn btn--primario cab__cta">Cotizar</a>
    </div>

    <button class="cab__menu" id="btn-menu" aria-label="Abrir menú" aria-expanded="false" aria-controls="nav-movil">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="cab__movil" id="nav-movil" hidden>
    <nav class="contenedor" aria-label="Principal (móvil)">
      {enlaces.map((e) => <a href={e.href} class="cab__movil-enlace">{e.texto}</a>)}
      <a href="https://amprod.nexoriachile.com/" class="cab__movil-enlace" rel="noopener">Ingresar a AMPROD</a>
      <a href="/contacto/" class="btn btn--primario" style="margin-top:12px">Cotizar</a>
    </nav>
  </div>
</header>

<style>
  .cab {
    position: sticky; top: 0; z-index: 60;
    background: rgba(255, 255, 255, .82);
    backdrop-filter: saturate(170%) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color .25s ease, box-shadow .25s ease, background .25s ease;
  }
  .cab.fijo { border-bottom-color: var(--borde); box-shadow: 0 6px 24px -18px rgba(18, 26, 51, .5); }

  .cab__fila { display: flex; align-items: center; gap: 28px; height: 72px; }
  .cab__logo { flex: none; display: flex; align-items: center; }
  .cab__logo img { height: 32px; width: auto; }

  .cab__nav { display: flex; gap: 4px; margin-left: auto; }
  .cab__enlace {
    padding: 9px 14px; border-radius: 9px; font-size: 15px; font-weight: 550;
    color: var(--texto-2); transition: color .2s ease, background .2s ease;
  }
  .cab__enlace:hover { color: var(--nx-indigo); background: var(--fondo-2); }
  .cab__enlace.es-activo { color: var(--nx-indigo); font-weight: 650; }

  .cab__acciones { display: flex; align-items: center; gap: 12px; }
  .cab__acceso { font-size: 15px; font-weight: 550; color: var(--texto-2); padding: 9px 4px; }
  .cab__acceso:hover { color: var(--nx-azul); }
  .cab__cta { padding: 10px 20px; font-size: 14.5px; }

  .cab__menu {
    display: none; margin-left: auto; width: 42px; height: 42px;
    background: none; border: 1px solid var(--borde); border-radius: 10px;
    cursor: pointer; padding: 11px 10px;
    flex-direction: column; justify-content: space-between;
  }
  .cab__menu span { display: block; height: 2px; background: var(--nx-indigo); border-radius: 2px; transition: transform .25s ease, opacity .2s ease; }
  .cab__menu[aria-expanded='true'] span:nth-child(1) { transform: translateY(9px) rotate(45deg); }
  .cab__menu[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .cab__menu[aria-expanded='true'] span:nth-child(3) { transform: translateY(-9px) rotate(-45deg); }

  .cab__movil { border-top: 1px solid var(--borde); background: #fff; padding: 14px 0 22px; }
  .cab__movil nav { display: flex; flex-direction: column; gap: 2px; }
  .cab__movil-enlace { padding: 13px 4px; font-size: 16.5px; font-weight: 550; color: var(--texto); border-bottom: 1px solid var(--fondo-3); }

  @media (max-width: 900px) {
    .cab__nav, .cab__acciones { display: none; }
    .cab__menu { display: flex; }
  }
</style>

<script>
  const cab = document.getElementById('cab')!;
  const btn = document.getElementById('btn-menu')!;
  const movil = document.getElementById('nav-movil')!;

  const alScroll = () => cab.classList.toggle('fijo', window.scrollY > 8);
  alScroll();
  addEventListener('scroll', alScroll, { passive: true });

  btn.addEventListener('click', () => {
    const abierto = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!abierto));
    btn.setAttribute('aria-label', abierto ? 'Abrir menú' : 'Cerrar menú');
    movil.hidden = abierto;
  });
</script>
