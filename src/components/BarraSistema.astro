---
/**
 * Barra superior en módulos, al estilo de una barra de estado de escritorio:
 * pastillas separadas en vez de una franja continua. No es un menú — la
 * navegación va en el dock inferior.
 *
 * IMPORTANTE: las lecturas son de DEMOSTRACIÓN, no miden nada. Por eso el
 * módulo va rotulado y con `title`: un visitante no debe creer que está
 * viendo el estado real de producción. Si algún día se conectan a AMPROD,
 * hay que quitar el rótulo "demo" y la fluctuación simulada.
 */
const lecturas = [
  { k: 'Nodos', v: '248', u: '' },
  { k: 'Ingesta', v: '1.2k', u: '/min' },
  { k: 'Latencia', v: '38', u: 'ms' },
];
---

<header class="bs">
  <!-- Módulo: marca -->
  <a href="/" class="mod mod--marca" aria-label="Nexoria — inicio">
    <img src="/marca/svg/nexoria-horizontal-oscuro.svg" alt="Nexoria" width="112" height="25" />
  </a>

  <div class="bs__centro">
    <!-- Módulo: estado del sistema -->
    <span class="mod mod--estado" aria-hidden="true">
      <i class="mod__led"></i>
      <span class="mod__txt">Sistema operativo</span>
    </span>

    <!-- Módulo: lecturas -->
    <span class="mod mod--lecturas" title="Lecturas de demostración: no reflejan un sistema en producción.">
      <span class="mod__rotulo">demo</span>
      <i class="mod__div"></i>
      {lecturas.map((l, i) => (
        <>
          {i > 0 && <i class="mod__div"></i>}
          <span class="lec">
            <em>{l.k}</em>
            <b data-base={l.v}>{l.v}</b>{l.u && <u>{l.u}</u>}
          </span>
        </>
      ))}
    </span>

    <!-- Módulo: alarmas -->
    <span class="mod mod--alarmas" aria-hidden="true" title="Valor de demostración.">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8.5a6 6 0 1 0-12 0c0 6-2.5 7.5-2.5 7.5h17S18 14.5 18 8.5Z"/><path d="M13.7 20a2 2 0 0 1-3.4 0"/></svg>
      <span class="mod__txt">Alarmas</span>
      <b>0</b>
    </span>
  </div>

  <!-- Módulo: reloj -->
  <span class="mod mod--reloj" aria-hidden="true">
    <i class="mod__punto"></i>
    <b id="bs-reloj">--:--:--</b>
  </span>
</header>

<style>
  .bs {
    position: fixed; inset: 0 0 auto 0; z-index: 70;
    height: var(--bs-alto);
    display: flex; align-items: center; gap: 10px;
    padding: 0 12px;
    /* La barra no pinta fondo: lo ponen las pastillas */
    background: linear-gradient(180deg, rgba(5, 9, 24, .92), rgba(5, 9, 24, .62) 70%, transparent);
    backdrop-filter: blur(10px);
    font-size: 10.5px; letter-spacing: .09em; text-transform: uppercase; font-weight: 650;
    pointer-events: none;
  }

  /* ---- Módulo base: la pastilla ---- */
  .mod {
    pointer-events: auto;
    display: inline-flex; align-items: center; gap: 9px;
    height: 30px; padding: 0 13px;
    border-radius: 9px;
    background: rgba(17, 26, 66, .72);
    border: 1px solid rgba(110, 170, 235, .16);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .05), 0 6px 16px -10px rgba(0, 0, 0, .9);
    color: #8ea0c4; white-space: nowrap;
    transition: border-color .22s ease, background .22s ease, transform .22s ease;
  }
  .mod:hover { border-color: rgba(70, 192, 216, .4); background: rgba(22, 34, 82, .82); }

  .mod__div { width: 1px; height: 13px; background: rgba(110, 170, 235, .22); flex: none; }
  .mod__txt { color: #8ea0c4; }

  /* ---- Marca ---- */
  .mod--marca { flex: none; padding: 0 14px; }
  .mod--marca img { height: 17px; width: auto; transition: opacity .2s ease; }
  .mod--marca:hover { transform: translateY(-1px); }
  .mod--marca:hover img { opacity: .85; }

  .bs__centro { flex: 1; display: flex; align-items: center; justify-content: center; gap: 10px; min-width: 0; }

  /* ---- Estado ---- */
  .mod--estado { color: #9edcf2; }
  .mod__led {
    width: 6px; height: 6px; border-radius: 50%; background: #22c55e; flex: none;
    box-shadow: 0 0 0 0 rgba(34, 197, 94, .7);
    animation: bs-latir 2.6s cubic-bezier(.2, .7, .3, 1) infinite;
  }
  @keyframes bs-latir { 70% { box-shadow: 0 0 0 7px rgba(34, 197, 94, 0); } 100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); } }

  /* ---- Lecturas ---- */
  .mod--lecturas { gap: 9px; cursor: help; }
  .mod__rotulo {
    font-size: 9px; letter-spacing: .14em; font-weight: 700;
    color: #7c6a3a; background: rgba(250, 178, 25, .16);
    border: 1px solid rgba(250, 178, 25, .3); color: #d9a93c;
    padding: 1px 6px; border-radius: 5px; flex: none;
  }
  .lec { display: inline-flex; align-items: baseline; gap: 5px; }
  .lec em { font-style: normal; color: #5d6a8c; }
  .lec b { color: var(--nx-cian); font-variant-numeric: tabular-nums; font-weight: 700; }
  .lec u { text-decoration: none; color: #5d6a8c; }

  /* ---- Alarmas: en verde mientras esté en cero ---- */
  .mod--alarmas { color: #6ee36e; border-color: rgba(34, 197, 94, .28); background: rgba(12, 163, 12, .12); }
  .mod--alarmas:hover { border-color: rgba(34, 197, 94, .5); background: rgba(12, 163, 12, .18); }
  .mod--alarmas .mod__txt { color: #6ee36e; }
  .mod--alarmas b { color: #fff; font-variant-numeric: tabular-nums; }

  /* ---- Reloj ---- */
  .mod--reloj { flex: none; }
  .mod--reloj b { color: #cbd6ee; font-variant-numeric: tabular-nums; letter-spacing: .06em; font-weight: 650; }
  .mod__punto { width: 4px; height: 4px; border-radius: 50%; background: var(--nx-cian); flex: none; opacity: .8; }

  @media (max-width: 1180px) { .mod--lecturas .lec:nth-child(n+5) { display: none; } }
  @media (max-width: 980px) { .mod--lecturas { display: none; } }
  @media (max-width: 720px) {
    .bs { gap: 7px; padding: 0 9px; }
    .mod { height: 28px; padding: 0 10px; gap: 7px; }
    .mod--estado .mod__txt, .mod--alarmas .mod__txt { display: none; }
  }
  @media (max-width: 420px) { .mod--alarmas { display: none; } }

  @media (prefers-reduced-motion: reduce) { .mod__led { animation: none; } }
</style>

<script>
  let montado = false;

  function montarBarra() {
    if (montado) return;
    montado = true;

    const reloj = document.getElementById('bs-reloj');
    if (reloj) {
      const tic = () => { reloj.textContent = new Date().toLocaleTimeString('es-CL', { hour12: false }); };
      tic();
      setInterval(tic, 1000);
    }

    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const vals = document.querySelectorAll<HTMLElement>('.lec b[data-base]');
      if (!vals.length) return;
      setInterval(() => {
        vals.forEach((el) => {
          const txt = el.dataset.base ?? '';
          if (txt.includes('k')) {
            el.textContent = (1.2 + (Math.random() - 0.5) * 0.18).toFixed(1) + 'k';
          } else {
            const base = parseFloat(txt);
            if (!Number.isFinite(base) || base === 0) return;
            el.textContent = String(Math.max(0, Math.round(base + (Math.random() - 0.5) * base * 0.09)));
          }
        });
      }, 2200);
    }
  }

  document.addEventListener('astro:page-load', montarBarra);
</script>
