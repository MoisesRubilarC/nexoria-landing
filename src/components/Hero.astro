---
interface Props {
  sobretitulo?: string;
  titulo: string;
  destacado?: string;
  bajada: string;
  compacto?: boolean;
}
const { sobretitulo, titulo, destacado, bajada, compacto = false } = Astro.props;
---

<section class:list={['hero', { 'hero--compacto': compacto }]}>
  <canvas id="red-sensores" class="hero__lienzo" aria-hidden="true"></canvas>
  <div class="hero__rejilla" aria-hidden="true"></div>
  <div class="hero__brillo hero__brillo--a" aria-hidden="true"></div>
  <div class="hero__brillo hero__brillo--b" aria-hidden="true"></div>

  <div class="contenedor hero__contenido">
    {sobretitulo && <span class="hero__sobretitulo">{sobretitulo}</span>}
    <h1>
      {titulo}
      {destacado && <><br /><span class="hero__grad">{destacado}</span></>}
    </h1>
    <p class="hero__bajada">{bajada}</p>
    <div class="hero__acciones">
      <slot />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--nx-noche);
    color: #dbe4f5;
    overflow: hidden;
    padding: clamp(80px, 13vw, 150px) 0 clamp(72px, 11vw, 124px);
    isolation: isolate;
  }
  .hero--compacto { padding: clamp(60px, 8vw, 92px) 0 clamp(56px, 7vw, 80px); }

  .hero__lienzo { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; }

  .hero__rejilla {
    position: absolute; inset: -40% -20% -10%; z-index: 0; pointer-events: none; opacity: .5;
    background-image:
      linear-gradient(rgba(130, 170, 230, .13) 1px, transparent 1px),
      linear-gradient(90deg, rgba(130, 170, 230, .13) 1px, transparent 1px);
    background-size: 62px 62px;
    transform: perspective(620px) rotateX(63deg) translateY(10%);
    mask-image: linear-gradient(to bottom, transparent 44%, #000 66%, transparent 94%);
    -webkit-mask-image: linear-gradient(to bottom, transparent 44%, #000 66%, transparent 94%);
    animation: deriva 22s linear infinite;
  }
  @keyframes deriva { to { background-position: 0 62px, 62px 0; } }

  .hero__brillo { position: absolute; z-index: 0; border-radius: 50%; filter: blur(95px); pointer-events: none; animation: flotar 17s ease-in-out infinite alternate; }
  .hero__brillo--a { width: 48vmax; height: 48vmax; left: -16vmax; top: -20vmax; background: radial-gradient(circle, rgba(45, 102, 171, .50), transparent 66%); }
  .hero__brillo--b { width: 40vmax; height: 40vmax; right: -14vmax; bottom: -18vmax; background: radial-gradient(circle, rgba(70, 192, 216, .30), transparent 66%); animation-delay: -7s; }
  @keyframes flotar { to { transform: translate3d(4vmax, 3vmax, 0) scale(1.14); } }

  .hero__contenido { position: relative; z-index: 2; }
  .hero__contenido :global(h1) { color: #fff; max-width: 16ch; }

  .hero__sobretitulo {
    display: inline-flex; align-items: center; gap: 9px;
    padding: 7px 16px; margin-bottom: 22px; border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, .16); background: rgba(255, 255, 255, .05);
    backdrop-filter: blur(10px);
    font-size: 12.5px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: #9edcf2;
  }

  .hero__grad {
    background: linear-gradient(100deg, #9edcf2, #46C0D8 48%, #7fb6ff);
    background-size: 220% 100%;
    -webkit-background-clip: text; background-clip: text; color: transparent;
    animation: vaiven 9s ease-in-out infinite;
  }
  @keyframes vaiven { 0%, 100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }

  .hero__bajada { margin-top: 24px; max-width: 58ch; font-size: clamp(16.5px, 2.2vw, 20px); color: #a9b6d4; }
  .hero__acciones { display: flex; flex-wrap: wrap; gap: 13px; margin-top: 36px; }

  @media (prefers-reduced-motion: reduce) { .hero__rejilla, .hero__brillo, .hero__grad { animation: none; } }
</style>

<script>
let cortar: (() => void) | null = null;

function montarHero() {
  cortar?.();
  cortar = null;

  // Red de sensores: nodos que se enlazan al acercarse y reaccionan al puntero.
  const lienzo = document.getElementById('red-sensores') as HTMLCanvasElement | null;
  if (!lienzo || matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  const ctx = lienzo.getContext('2d')!;
  type Nodo = { x: number; y: number; vx: number; vy: number; r: number; p: number };
  let w = 0, h = 0, nodos: Nodo[] = [], raf = 0;
  const mouse = { x: -9999, y: -9999 };
  const LINK = 148;

  function resize() {
    const dpr = Math.min(devicePixelRatio || 1, 2);
    w = lienzo!.clientWidth; h = lienzo!.clientHeight;
    lienzo!.width = w * dpr; lienzo!.height = h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const n = Math.round(Math.min(90, Math.max(28, (w * h) / 19000)));
    nodos = Array.from({ length: n }, () => ({
      x: Math.random() * w, y: Math.random() * h,
      vx: (Math.random() - .5) * .22, vy: (Math.random() - .5) * .22,
      r: Math.random() * 1.5 + .8, p: Math.random() * Math.PI * 2,
    }));
  }

  function frame(t: number) {
    ctx.clearRect(0, 0, w, h);
    for (const n of nodos) {
      n.x += n.vx; n.y += n.vy;
      if (n.x < 0 || n.x > w) n.vx *= -1;
      if (n.y < 0 || n.y > h) n.vy *= -1;
    }
    for (let i = 0; i < nodos.length; i++) {
      for (let j = i + 1; j < nodos.length; j++) {
        const a = nodos[i], b = nodos[j];
        const dx = a.x - b.x, dy = a.y - b.y;
        const d2 = dx * dx + dy * dy;
        if (d2 > LINK * LINK) continue;
        ctx.strokeStyle = `rgba(120,180,255,${(1 - Math.sqrt(d2) / LINK) * 0.22})`;
        ctx.lineWidth = 1;
        ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
      }
    }
    for (const n of nodos) {
      const dx = n.x - mouse.x, dy = n.y - mouse.y;
      const cerca = dx * dx + dy * dy < 150 * 150;
      const puls = .55 + .45 * Math.sin(t / 700 + n.p);
      ctx.beginPath();
      ctx.arc(n.x, n.y, n.r * (cerca ? 2.1 : 1), 0, Math.PI * 2);
      ctx.fillStyle = cerca
        ? `rgba(70,192,216,${.55 + .35 * puls})`
        : `rgba(158,200,255,${.22 + .3 * puls})`;
      ctx.fill();
    }
    raf = requestAnimationFrame(frame);
  }

  const alMover = (e: PointerEvent) => {
    const c = lienzo!.getBoundingClientRect();
    mouse.x = e.clientX - c.left; mouse.y = e.clientY - c.top;
  };
  const alSalir = () => { mouse.x = mouse.y = -9999; };
  const alVisibilidad = () => {
    cancelAnimationFrame(raf);
    if (!document.hidden) raf = requestAnimationFrame(frame);
  };

  addEventListener('resize', resize, { passive: true });
  addEventListener('pointermove', alMover, { passive: true });
  addEventListener('pointerleave', alSalir);
  document.addEventListener('visibilitychange', alVisibilidad);

  resize();
  raf = requestAnimationFrame(frame);

  cortar = () => {
    cancelAnimationFrame(raf);
    removeEventListener('resize', resize);
    removeEventListener('pointermove', alMover);
    removeEventListener('pointerleave', alSalir);
    document.removeEventListener('visibilitychange', alVisibilidad);
  };
}

document.addEventListener('astro:before-swap', () => { cortar?.(); cortar = null; });
document.addEventListener('astro:page-load', montarHero);
</script>
