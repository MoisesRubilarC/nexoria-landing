---
/**
 * Dock de navegación: pastilla flotante centrada abajo. Reemplaza al menú
 * superior y al riel lateral. La pastilla activa se desliza entre ítems.
 */
const { pathname } = Astro.url;
const activo = (r: string) => (r === '/' ? pathname === '/' : pathname.startsWith(r));

const items = [
  { href: '/', texto: 'Inicio', icono: '<path d="M3 10.5 12 3l9 7.5"/><path d="M5.5 9.5V21h13V9.5"/>' },
  { href: '/servicios/', texto: 'Servicios', icono: '<path d="M3 12h4l2-6 4 12 2-6h6"/>' },
  { href: '/amprod/', texto: 'AMPROD', icono: '<rect x="3" y="4" width="18" height="16" rx="2.5"/><path d="M3 9h18"/><path d="M8.5 13v4M12 11.5V17M15.5 14.5V17"/>' },
  { href: '/nosotros/', texto: 'Nosotros', icono: '<circle cx="9" cy="8" r="3.2"/><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6"/><path d="M17 11.2A3 3 0 1 0 16 5.5"/><path d="M18 20c0-2.2-.7-3.9-1.9-5"/>' },
];
---

<nav class="dock" id="dock" aria-label="Principal">
  <div class="dock__caja">
    <span class="dock__resalte" id="dock-resalte" aria-hidden="true"></span>

    {items.map((i) => (
      <a href={i.href} class:list={['dock__item', { 'es-activo': activo(i.href) }]} data-dock>
        <span class="dock__icono">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={i.icono} />
        </span>
        <span class="dock__texto">{i.texto}</span>
      </a>
    ))}

    <span class="dock__div" aria-hidden="true"></span>

    <a href="/contacto/" class:list={['dock__cta', { 'es-activo': activo('/contacto/') }]}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
      <span>Cotizar</span>
    </a>
  </div>
</nav>

<style>
  .dock {
    position: fixed; z-index: 72;
    left: 50%; bottom: 20px; translate: -50% 0;
    max-width: calc(100vw - 24px);
  }

  .dock__caja {
    position: relative;
    display: flex; align-items: center; gap: 3px;
    padding: 7px;
    border-radius: 999px;
    background: rgba(9, 15, 36, .82);
    backdrop-filter: blur(18px) saturate(160%);
    border: 1px solid rgba(110, 170, 235, .22);
    box-shadow:
      0 22px 50px -18px rgba(0, 0, 0, .95),
      inset 0 1px 0 rgba(255, 255, 255, .07);
  }

  /* Pastilla que se desliza bajo el ítem activo */
  .dock__resalte {
    position: absolute; top: 7px; bottom: 7px; left: 0; width: 0;
    border-radius: 999px;
    background: linear-gradient(140deg, rgba(70, 192, 216, .22), rgba(45, 102, 171, .3));
    border: 1px solid rgba(70, 192, 216, .4);
    opacity: 0;
    transition: transform .42s cubic-bezier(.22, .9, .25, 1),
                width .42s cubic-bezier(.22, .9, .25, 1),
                opacity .25s ease;
    pointer-events: none;
  }

  .dock__item {
    position: relative; z-index: 1;
    display: flex; align-items: center; gap: 8px;
    padding: 10px 15px; border-radius: 999px;
    color: #8696ba; white-space: nowrap;
    font-size: 13.5px; font-weight: 600;
    transition: color .22s ease;
  }
  .dock__item:hover { color: #e2e8f0; }
  .dock__item.es-activo { color: #fff; }
  .dock__item.es-activo .dock__icono { color: var(--nx-cian); }
  .dock__icono { display: grid; place-items: center; flex: none; transition: color .22s ease, transform .3s ease; }
  .dock__item:hover .dock__icono { transform: translateY(-2px); }

  .dock__div { width: 1px; height: 22px; margin: 0 5px; background: rgba(110, 170, 235, .22); flex: none; }

  .dock__cta {
    position: relative; z-index: 1;
    display: flex; align-items: center; gap: 8px;
    padding: 10px 18px; border-radius: 999px;
    color: #04121c; background: var(--nx-degradado); background-size: 160% 100%;
    font-size: 13.5px; font-weight: 700; white-space: nowrap;
    box-shadow: 0 8px 22px -10px rgba(45, 102, 171, .95);
    transition: background-position .4s ease, transform .22s ease, box-shadow .3s ease;
  }
  .dock__cta:hover {
    background-position: 100% 0; transform: translateY(-2px);
    box-shadow: 0 14px 30px -12px rgba(70, 192, 216, .9);
  }

  @media (max-width: 720px) {
    .dock { bottom: 12px; width: calc(100vw - 20px); }
    .dock__caja { justify-content: space-between; padding: 6px; gap: 0; }
    .dock__item { flex-direction: column; gap: 3px; padding: 7px 8px; font-size: 10px; flex: 1; }
    .dock__texto { font-size: 10px; }
    .dock__div { display: none; }
    .dock__cta { flex-direction: column; gap: 3px; padding: 7px 12px; font-size: 10px; }
    .dock__cta svg { width: 15px; height: 15px; }
    .dock__resalte { top: 6px; bottom: 6px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .dock__resalte { transition: none; }
  }
</style>

<script>
  function montarDock() {
    const caja = document.querySelector<HTMLElement>('.dock__caja');
    const resalte = document.getElementById('dock-resalte');
    if (!caja || !resalte) return;

    const colocar = (el: HTMLElement | null, visible: boolean) => {
      if (!el) { resalte.style.opacity = '0'; return; }
      resalte.style.width = `${el.offsetWidth}px`;
      resalte.style.transform = `translateX(${el.offsetLeft}px)`;
      resalte.style.opacity = visible ? '1' : '0';
    };

    const actual = () => caja.querySelector<HTMLElement>('.dock__item.es-activo');

    // Posición inicial, sin transición para que no "vuele" al cargar
    const previa = resalte.style.transition;
    resalte.style.transition = 'none';
    colocar(actual(), true);
    void resalte.offsetWidth;
    resalte.style.transition = previa;

    caja.querySelectorAll<HTMLElement>('[data-dock]').forEach((item) => {
      item.addEventListener('pointerenter', () => colocar(item, true));
    });
    caja.addEventListener('pointerleave', () => colocar(actual(), true));
    addEventListener('resize', () => colocar(actual(), true), { passive: true });
  }

  document.addEventListener('astro:page-load', montarDock);
</script>
