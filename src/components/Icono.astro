---
interface Props {
  nombre: 'senal' | 'temperatura' | 'prediccion' | 'alerta' | 'integracion' | 'tablero';
  tam?: number;
}
const { nombre, tam = 24 } = Astro.props;

// Trazos de cada ícono. Se dibujan con currentColor para heredar el contexto.
const trazos: Record<Props['nombre'], string> = {
  senal: '<path d="M3 12h3.5l2.5 7 4-14 2.5 7H21"/>',
  temperatura: '<path d="M14 4.5V14a4 4 0 1 1-4 0V4.5a2 2 0 1 1 4 0Z"/><path d="M12 11v5"/>',
  prediccion: '<path d="M3 17l5-5 3.5 3.5L21 6"/><path d="M15 6h6v6"/><circle cx="8" cy="12" r="1.4" fill="currentColor" stroke="none"/>',
  alerta: '<path d="M12 3 2.5 20h19L12 3Z"/><path d="M12 10v4.5"/><path d="M12 17.6h.01"/>',
  integracion: '<circle cx="6" cy="6" r="2.6"/><circle cx="18" cy="6" r="2.6"/><circle cx="12" cy="18" r="2.6"/><path d="M7.8 7.8 11 15"/><path d="M16.2 7.8 13 15"/><path d="M8.6 6h6.8"/>',
  tablero: '<rect x="3" y="4" width="18" height="16" rx="2.5"/><path d="M3 9h18"/><path d="M8.5 13v4"/><path d="M12 11.5v5.5"/><path d="M15.5 14.5v2.5"/>',
};
---

<svg
  width={tam}
  height={tam}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={trazos[nombre]}
/>
