---
/**
 * Riel de navegación lateral. Reemplaza al menú superior: en escritorio es una
 * columna fija que se expande al pasar el cursor; en móvil se convierte en una
 * barra inferior al alcance del pulgar.
 */
const { pathname } = Astro.url;
const activo = (r: string) => (r === '/' ? pathname === '/' : pathname.startsWith(r));

const items = [
  { href: '/', texto: 'Inicio', icono: '<path d="M3 10.5 12 3l9 7.5"/><path d="M5.5 9.5V21h13V9.5"/>' },
  { href: '/servicios/', texto: 'Servicios', icono: '<path d="M3 12h4l2-6 4 12 2-6h6"/>' },
  { href: '/amprod/', texto: 'AMPROD', icono: '<rect x="3" y="4" width="18" height="16" rx="2.5"/><path d="M3 9h18"/><path d="M8.5 13v4M12 11.5V17M15.5 14.5V17"/>' },
  { href: '/nosotros/', texto: 'Nosotros', icono: '<circle cx="9" cy="8" r="3.2"/><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6"/><path d="M17 11.2A3 3 0 1 0 16 5.5"/><path d="M18 20c0-2.2-.7-3.9-1.9-5"/>' },
  { href: '/contacto/', texto: 'Contacto', icono: '<rect x="2.5" y="5" width="19" height="14" rx="2.5"/><path d="m3.5 7 8.5 6 8.5-6"/>' },
];
---

<nav class="riel" aria-label="Principal">
  <a href="/" class="riel__marca" aria-label="Nexoria — inicio">
    <img src="/marca/svg/nexoria-isotipo-oscuro.svg" alt="" class="riel__iso" width="30" height="30" />
    <img src="/marca/svg/nexoria-horizontal-oscuro.svg" alt="Nexoria" class="riel__completo" width="140" height="32" />
  </a>

  <ul class="riel__lista">
    {items.map((i) => (
      <li>
        <a href={i.href} class:list={['riel__enlace', { 'es-activo': activo(i.href) }]}>
          <span class="riel__icono">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={i.icono} />
          </span>
          <span class="riel__texto">{i.texto}</span>
        </a>
      </li>
    ))}
  </ul>

  <a href="/contacto/" class="riel__cta">
    <span class="riel__icono">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14" /></svg>
    </span>
    <span class="riel__texto">Cotizar</span>
  </a>
</nav>

<style>
  .riel {
    position: fixed; z-index: 65;
    top: 0; bottom: var(--barra-alto); left: 0; width: var(--riel-ancho);
    display: flex; flex-direction: column; justify-content: space-between;
    padding: 0 0 20px;
    background: rgba(5, 9, 24, .9);
    backdrop-filter: blur(12px);
    border-right: 1px solid rgba(110, 170, 235, .14);
    transition: width .32s cubic-bezier(.2, .7, .2, 1);
    overflow: hidden;
  }
  .riel:hover, .riel:focus-within { width: var(--riel-abierto); }

  .riel__tope { display: flex; flex-direction: column; }

  .riel__marca {
    position: relative; display: flex; align-items: center;
    height: 58px; padding-left: 19px; margin-bottom: 14px;
    border-bottom: 1px solid rgba(110, 170, 235, .12);
  }
  .riel__iso {
    height: 29px; width: auto; flex: none;
    transition: opacity .2s ease;
  }
  .riel__completo {
    position: absolute; left: 18px;
    height: 27px; width: auto;
    opacity: 0; transform: translateX(-6px);
    transition: opacity .26s ease, transform .26s ease;
  }
  .riel:hover .riel__iso, .riel:focus-within .riel__iso { opacity: 0; }
  .riel:hover .riel__completo, .riel:focus-within .riel__completo { opacity: 1; transform: none; }

  .riel__lista { list-style: none; display: flex; flex-direction: column; gap: 4px; }

  .riel__enlace, .riel__cta {
    position: relative;
    display: flex; align-items: center; gap: 14px;
    height: 48px; padding-left: 20px;
    color: #7c89ab; white-space: nowrap;
    transition: color .2s ease, background .2s ease;
  }
  .riel__enlace:hover, .riel__cta:hover { color: #fff; background: rgba(110, 170, 235, .08); }

  .riel__enlace.es-activo { color: #fff; }
  .riel__enlace.es-activo::before {
    content: ''; position: absolute; left: 0; top: 10px; bottom: 10px; width: 3px;
    border-radius: 0 3px 3px 0; background: var(--nx-cian);
    box-shadow: 0 0 14px rgba(70, 192, 216, .9);
  }
  .riel__enlace.es-activo .riel__icono { color: var(--nx-cian); }

  .riel__icono { flex: none; display: grid; place-items: center; width: 22px; }
  .riel__texto {
    font-size: 14px; font-weight: 600; letter-spacing: -.01em;
    opacity: 0; transform: translateX(-6px);
    transition: opacity .26s ease, transform .26s ease;
  }
  .riel:hover .riel__texto, .riel:focus-within .riel__texto { opacity: 1; transform: none; }

  .riel__cta { margin: 0 12px; height: 46px; padding-left: 8px; border-radius: 11px; color: #04121c; background: var(--nx-degradado); font-weight: 650; }
  .riel__cta .riel__icono { width: 30px; }
  .riel__cta:hover { color: #fff; filter: brightness(1.08); }

  /* Móvil: barra inferior */
  @media (max-width: 900px) {
    .riel {
      top: auto; bottom: var(--barra-alto); left: 0; right: 0; width: 100%; height: var(--riel-movil);
      flex-direction: row; align-items: center; padding: 0 6px;
      border-right: none; border-top: 1px solid rgba(110, 170, 235, .16);
      box-shadow: 0 -10px 30px -18px rgba(0, 0, 0, .9);
    }
    .riel:hover, .riel:focus-within { width: 100%; }
    .riel__marca { display: none; }
    .riel__lista { flex-direction: row; flex: 1; gap: 0; justify-content: space-around; }
    .riel__enlace {
      flex-direction: column; gap: 3px; height: auto; padding: 8px 4px; justify-content: center;
    }
    .riel__enlace.es-activo::before { left: 50%; translate: -50% 0; top: 0; bottom: auto; width: 26px; height: 3px; border-radius: 0 0 3px 3px; }
    .riel__texto { opacity: 1; transform: none; font-size: 10.5px; font-weight: 600; }
    .riel__cta { margin: 0 4px 0 2px; padding: 0 14px; height: 40px; }
    .riel__cta .riel__texto { display: none; }
  }
</style>
