---
// Cinta de lecturas de ejemplo. Son valores ilustrativos del tipo de variable
// que la plataforma captura, no datos de un cliente real.
const lecturas = [
  ['Línea 01 · Temperatura', '72.4', '°C'],
  ['Motor A3 · Vibración', '0.42', 'mm/s'],
  ['Compresor · Presión', '6.8', 'bar'],
  ['Horno 2 · Consumo', '118', 'kW'],
  ['Bomba B1 · Velocidad', '1480', 'rpm'],
  ['Variador 07 · Corriente', '34.6', 'A'],
  ['Línea 03 · Disponibilidad', '99.2', '%'],
];
---

<div class="cinta" aria-hidden="true">
  <div class="cinta__pista" id="cinta-pista">
    {[0, 1].map(() => lecturas.map(([etiqueta, valor, unidad]) => (
      <span class="lectura">
        {etiqueta}
        <b data-base={valor} data-unidad={unidad}>{valor} {unidad}</b>
      </span>
    )))}
  </div>
</div>

<p class="solo-lectores">
  Muestra ilustrativa de las variables que Nexoria captura: temperatura, vibración,
  presión, consumo, velocidad, corriente y disponibilidad.
</p>

<style>
  .cinta {
    background: var(--nx-noche-2);
    border-bottom: 1px solid rgba(255, 255, 255, .08);
    padding: 15px 0; overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .cinta__pista { display: flex; gap: 46px; width: max-content; animation: correr 38s linear infinite; }
  .cinta:hover .cinta__pista { animation-play-state: paused; }
  @keyframes correr { to { transform: translateX(-50%); } }

  .lectura {
    display: inline-flex; align-items: center; gap: 10px; white-space: nowrap;
    font-size: 12.5px; font-weight: 600; letter-spacing: .13em; text-transform: uppercase;
    color: #7c89ab;
  }
  .lectura b { color: var(--nx-cian); font-variant-numeric: tabular-nums; font-weight: 700; }

  @media (prefers-reduced-motion: reduce) { .cinta__pista { animation: none; } }
</style>

<script>
let montado = false;

function montarCinta() {
  if (montado) return;
  montado = true;


    // Fluctuación suave para que las lecturas se sientan vivas.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const valores = document.querySelectorAll<HTMLElement>('#cinta-pista b');
      setInterval(() => {
        valores.forEach((el) => {
          const base = parseFloat(el.dataset.base ?? '');
          if (!Number.isFinite(base) || base === 0) return;
          const decimales = (el.dataset.base ?? '').split('.')[1]?.length ?? 0;
          const ruido = base * (Math.random() - 0.5) * 0.012;
          el.textContent = `${(base + ruido).toFixed(decimales)} ${el.dataset.unidad ?? ''}`;
        });
      }, 1700);
    }

}

document.addEventListener('astro:page-load', montarCinta);
</script>
