---
/**
 * Franja de cifras. Cada número es un "hero number" con su etiqueta;
 * no es un gráfico, así que no lleva ejes ni leyenda.
 *
 * TODO: ajustar con cifras reales a medida que la operación crezca.
 */
const cifras = [
  { valor: 7, sufijo: '', etiqueta: 'Variables por equipo', detalle: 'Corriente, frecuencia, torque, RPM, bus DC, voltaje y temperatura' },
  { valor: 1, sufijo: ' s', etiqueta: 'Resolución de muestreo', detalle: 'Lectura continua, sin esperar al informe del turno' },
  { valor: 24, sufijo: '/7', etiqueta: 'Monitoreo', detalle: 'La plataforma no descansa entre turnos' },
  { valor: 100, sufijo: ' %', etiqueta: 'Datos exportables', detalle: 'Tu información es tuya: Excel o API cuando la necesites' },
];
---

<section class="cifras">
  <div class="contenedor cifras__rejilla">
    {cifras.map((c) => (
      <article class="cifra revelar">
        <span class="cifra__numero">
          <b class="contador-cifra" data-hasta={c.valor}>0</b>{c.sufijo}
        </span>
        <h3 class="cifra__etiqueta">{c.etiqueta}</h3>
        <p class="cifra__detalle">{c.detalle}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .cifras { background: var(--fondo-2); border-bottom: 1px solid var(--borde); padding: clamp(48px, 6vw, 72px) 0; }
  .cifras__rejilla { display: grid; gap: 28px; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); }

  .cifra { padding-left: 18px; border-left: 2px solid var(--nx-cian); }
  .cifra__numero {
    display: block; font-size: clamp(34px, 4.6vw, 48px); font-weight: 700;
    letter-spacing: -.04em; line-height: 1;
    background: var(--nx-degradado); -webkit-background-clip: text; background-clip: text; color: transparent;
    font-variant-numeric: tabular-nums;
  }
  .cifra__etiqueta { margin-top: 12px; font-size: 16px; }
  .cifra__detalle { margin-top: 7px; font-size: 14px; color: var(--texto-2); }
</style>

<script>
  const cuentas = document.querySelectorAll<HTMLElement>('.contador-cifra');
  const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reducido) {
    cuentas.forEach((el) => { el.textContent = el.dataset.hasta ?? '0'; });
  } else {
    const obs = new IntersectionObserver((entradas) => {
      for (const e of entradas) {
        if (!e.isIntersecting) continue;
        const el = e.target as HTMLElement;
        const hasta = parseFloat(el.dataset.hasta ?? '0');
        const inicio = performance.now();
        const paso = (ahora: number) => {
          const t = Math.min(1, (ahora - inicio) / 1200);
          el.textContent = String(Math.round(hasta * (1 - Math.pow(1 - t, 3))));
          if (t < 1) requestAnimationFrame(paso);
        };
        requestAnimationFrame(paso);
        obs.unobserve(el);
      }
    }, { threshold: 0.5 });
    cuentas.forEach((el) => obs.observe(el));
  }
</script>
