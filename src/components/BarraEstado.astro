---
/**
 * Franja inferior tipo HMI, como la barra de estado de una sala de control.
 * No es un menú: la navegación vive en el riel lateral.
 */
const lecturas = [
  ['NODOS', '248', ''],
  ['INGESTA', '1.2k', '/min'],
  ['LATENCIA', '38', 'ms'],
  ['ALARMAS', '0', ''],
];
---

<div class="barra">
  <div class="barra__izq">
    <span class="barra__sistema">
      <i class="barra__led" aria-hidden="true"></i>
      Sistema operativo
    </span>
  </div>

  <div class="barra__centro" aria-hidden="true">
    {lecturas.map(([k, v, u]) => (
      <span class="barra__lectura">
        <em>{k}</em>
        <b data-base={v}>{v}</b>{u}
      </span>
    ))}
  </div>

  <div class="barra__der">
    <span class="barra__reloj" id="barra-reloj" aria-hidden="true">--:--:--</span>
    <span class="barra__sitio" aria-hidden="true">nexoriachile.com</span>
  </div>
</div>

<style>
  .barra {
    position: fixed; inset: auto 0 0 0; z-index: 70;
    height: var(--barra-alto);
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 0 16px;
    background: rgba(5, 9, 24, .92);
    backdrop-filter: blur(12px);
    border-top: 1px solid rgba(110, 170, 235, .16);
    font-size: 10.5px; letter-spacing: .1em; text-transform: uppercase;
    color: #6a779a; font-weight: 600;
  }

  .barra__izq, .barra__der { display: flex; align-items: center; gap: 14px; flex: none; }
  .barra__sistema { display: inline-flex; align-items: center; gap: 7px; color: #8ea0c4; }
  .barra__led {
    width: 6px; height: 6px; border-radius: 50%; background: #22c55e;
    box-shadow: 0 0 0 0 rgba(34, 197, 94, .7);
    animation: barra-latir 2.6s cubic-bezier(.2, .7, .3, 1) infinite;
  }
  @keyframes barra-latir { 70% { box-shadow: 0 0 0 7px rgba(34, 197, 94, 0); } 100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); } }

  .barra__centro { display: flex; gap: 22px; overflow: hidden; }
  .barra__lectura { display: inline-flex; align-items: baseline; gap: 6px; white-space: nowrap; }
  .barra__lectura em { font-style: normal; color: #4e5a78; }
  .barra__lectura b { color: var(--nx-cian); font-variant-numeric: tabular-nums; font-weight: 700; }

  .barra__reloj { color: #8ea0c4; font-variant-numeric: tabular-nums; letter-spacing: .06em; }
  .barra__sitio { color: #4e5a78; letter-spacing: .12em; }

  @media (max-width: 1100px) { .barra__centro { display: none; } }
  @media (max-width: 620px) { .barra__sitio { display: none; } }
</style>

<script>
let montado = false;

function montarBarra() {
  if (montado) return;
  montado = true;

    const reloj = document.getElementById('barra-reloj');
    if (reloj) {
      const tic = () => { reloj.textContent = new Date().toLocaleTimeString('es-CL', { hour12: false }); };
      tic();
      setInterval(tic, 1000);
    }

    // Fluctuación leve de las lecturas, para que la barra se sienta conectada.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const vals = document.querySelectorAll<HTMLElement>('.barra__lectura b[data-base]');
      setInterval(() => {
        vals.forEach((el) => {
          const txt = el.dataset.base ?? '';
          if (txt.includes('k')) {
            el.textContent = (1.2 + (Math.random() - 0.5) * 0.18).toFixed(1) + 'k';
          } else {
            const base = parseFloat(txt);
            if (!Number.isFinite(base) || base === 0) return;
            el.textContent = String(Math.max(0, Math.round(base + (Math.random() - 0.5) * base * 0.09)));
          }
        });
      }, 2200);
    }

}

document.addEventListener('astro:page-load', montarBarra);
</script>
